{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isched.local/specs/008-dod-mech-refactor/refactor-pass-artifact.schema.json",
  "title": "RefactorPassArtifact",
  "description": "Required artifact contract for accepting one data-oriented refactor pass.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "passId",
    "scope",
    "hotPaths",
    "coverageGate",
    "tests",
    "artifacts"
  ],
  "properties": {
    "passId": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "hotPaths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pathId", "baseline", "postPass", "actionsApplied", "nonRegression"],
        "properties": {
          "pathId": { "type": "string", "minLength": 1 },
          "baseline": { "$ref": "#/$defs/metricSnapshot" },
          "postPass": { "$ref": "#/$defs/metricSnapshot" },
          "actionsApplied": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "nonRegression": { "type": "boolean" }
        }
      }
    },
    "coverageGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lineCoveragePct", "branchCoveragePct", "thresholdLinePct", "thresholdBranchPct", "passed"],
      "properties": {
        "lineCoveragePct": { "type": "number", "minimum": 0, "maximum": 100 },
        "branchCoveragePct": { "type": "number", "minimum": 0, "maximum": 100 },
        "thresholdLinePct": { "type": "number", "const": 80 },
        "thresholdBranchPct": { "type": "number", "const": 80 },
        "passed": { "type": "boolean", "const": true },
        "reportPath": { "type": "string" }
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ctestGreen", "relevantSuites"],
      "properties": {
        "ctestGreen": { "type": "boolean", "const": true },
        "relevantSuites": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceUpdates", "testUpdates", "performanceSummary", "docsSpecUpdates"],
      "properties": {
        "sourceUpdates": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "\\.(hpp|cpp)$" }
        },
        "testUpdates": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "performanceSummary": { "type": "string", "minLength": 1 },
        "docsSpecUpdates": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "metricSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wallTimeNs", "samples"],
      "properties": {
        "wallTimeNs": { "type": "integer", "minimum": 1 },
        "cycles": { "type": "integer", "minimum": 0 },
        "instructions": { "type": "integer", "minimum": 0 },
        "branches": { "type": "integer", "minimum": 0 },
        "branchMisses": { "type": "integer", "minimum": 0 },
        "samples": { "type": "integer", "minimum": 1 },
        "environment": { "type": "string" }
      }
    }
  }
}

